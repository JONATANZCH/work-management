# Configuración de base de datos MySQL (Prisma)
# Ejemplo local con Docker Compose:
DATABASE_URL="mysql://root:root_password@localhost:3306/geest_db"

# Base de datos de pruebas (puerto 3307 por docker-compose)
TEST_DATABASE_URL="mysql://root:test_password@localhost:3307/geest_test_db"

# Webhook externo para notificaciones de archivado
NOTIFY_URL="http://localhost:3000/mock-notify"

# Puerto de la API
PORT=3000
